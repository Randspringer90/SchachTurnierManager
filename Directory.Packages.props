<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- [x.y.z] binds exactly the listed version; a bare version is only a minimum (STM-SEC-002).
         Keep every explicit reference exact, including framework-provided compatibility APIs. -->
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="[11.0.0]" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="[11.0.0]" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="[11.0.0]" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="[3.0.5]" />
    <!-- Bundle 3.0.5 has a lower-bound dependency; pin the separately serviced native engine. -->
    <PackageVersion Include="SQLite" Version="[3.54.1]" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="[18.12.0]" />
    <PackageVersion Include="xunit" Version="[2.9.3]" />
    <PackageVersion Include="xunit.analyzers" Version="[2.3.0]" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="[4.0.1]" />
    <PackageVersion Include="coverlet.collector" Version="[10.1.1]" />
  </ItemGroup>
</Project>
