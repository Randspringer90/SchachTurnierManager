{
  "$schema": "./provider-runtime-policy.schema.json",
  "schemaVersion": 2,
  "modelCatalogFile": "model-catalog.json",
  "description": "Laufzeitzuordnung logischer Profile zu lokalen, nichtinteraktiven CLI-Runtimes. Verwendet ausschliesslich vorhandene lokale Logins; persistiert keine Tokens/Secrets. Modell-Slugs sind Laufzeitdaten: die Runtime muss die Verfuegbarkeit vor Nutzung bestaetigen (kein stiller Wechsel). Proxy-Werte kommen ausschliesslich aus der Prozessumgebung und stehen nie in diesem Repo.",
  "providerPreference": {
    "anthropic": ["fabel", "opus", "sonnet"],
    "openai": ["sol", "terra", "luna"],
    "ollama": ["local-assist"]
  },
  "providers": {
    "anthropic": {
      "executable": "claude",
      "versionArgs": ["--version"],
      "invocation": {
        "argumentTemplate": ["-p", "--model", "{model}", "--permission-mode", "plan", "--permission-prompts", "none", "--tools", "Read,Glob,Grep", "--disallowedTools", "mcp__*", "--effort", "high", "--output-format", "text", "--add-dir", "{projectPath}"],
        "promptViaStdin": true,
        "readOnlyByDefault": true,
        "comment": "Expliziter Planmodus und ausschliesslich Read/Glob/Grep; MCP-Tools sind gesperrt. Nicht beantwortbare Toolfreigaben werden verweigert. High-Effort macht die Reviewtiefe unabhaengig vom Modell-Default; Ergebnisse bleiben T3."
      },
      "profiles": {
        "fabel": { "modelKey": "anthropicFabel" },
        "opus": { "modelKey": "anthropicOpus" },
        "sonnet": { "modelKey": "anthropicSonnet" }
      }
    },
    "openai": {
      "executable": "codex",
      "versionArgs": ["--version"],
      "authProbeArgs": ["login", "status"],
      "invocation": {
        "argumentTemplate": ["exec", "--model", "{model}", "--sandbox", "read-only", "--skip-git-repo-check", "--cd", "{projectPath}", "--output-last-message", "{lastMessageFile}", "-"],
        "promptViaStdin": true,
        "readOnlyByDefault": true,
        "comment": "Sandbox read-only: Child darf Repo lesen, aber nicht schreiben, nicht committen, nicht pushen."
      },
      "profiles": {
        "sol": { "modelKey": "openaiSol" },
        "terra": { "modelKey": "openaiLuna" },
        "luna": { "modelKey": "openaiSol" }
      }
    },
    "ollama": {
      "executable": "ollama",
      "versionArgs": ["--version"],
      "invocation": {
        "argumentTemplate": ["run", "{model}", "--hidethinking", "--nowordwrap"],
        "promptViaStdin": true,
        "readOnlyByDefault": true,
        "comment": "Lokales Modell ohne Werkzeuge: Prompt via stdin, Antwort auf stdout (T3). Kein Download (nie pull), nur Loopback-OLLAMA_HOST, Verfuegbarkeit ueber 'ollama list' bestaetigt (scripts/Invoke-LocalModelProfile.ps1)."
      },
      "profiles": {
        "local-assist": { "modelKey": "localGptOss20b" }
      }
    }
  },
  "safety": {
    "childrenMayCommit": false,
    "childrenMayPush": false,
    "childOutputTrustZone": "T3",
    "noSilentModelSwitch": true,
    "unavailableProfileAction": "block-and-request-explicit-reroute",
    "proxyEnvironmentVariables": ["HTTPS_PROXY", "HTTP_PROXY"],
    "proxyValueSource": "process-environment-only",
    "redactionPatternSource": "scripts/lib/RoutedExecutionCommon.ps1",
    "maxLoggedOutputChars": 20000
  },
  "retry": {
    "maxAttempts": 3,
    "baseDelaySeconds": 20,
    "backoffFactor": 2.0,
    "jitterSeconds": 10,
    "respectRetryAfter": true,
    "noParallelRetryStorms": true
  },
  "classification": {
    "usageLimit": [
      "usage limit",
      "usage_limit",
      "usage cap",
      "Nutzungslimit",
      "monthly limit",
      "weekly limit",
      "5-hour limit",
      "quota exceeded",
      "insufficient_quota",
      "out of credits"
    ],
    "rateLimit": [
      "rate limit",
      "rate_limit",
      "429",
      "retry-after",
      "overloaded",
      "capacity",
      "service unavailable",
      "temporarily unavailable",
      "503",
      "504"
    ],
    "authError": [
      "not logged in",
      "login required",
      "please run",
      "invalid api key",
      "unauthorized",
      "401",
      "403 forbidden",
      "token in keyring is invalid"
    ]
  }
}
