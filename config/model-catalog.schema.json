{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "STM central model catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "verifiedOn", "sources", "updatePolicy", "models"],
  "properties": {
    "$schema": { "type": "string", "const": "./model-catalog.schema.json" },
    "schemaVersion": { "const": 1 },
    "description": { "type": "string" },
    "verifiedOn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "sources": {
      "type": "object", "additionalProperties": false, "required": ["openai", "anthropic"],
      "properties": { "openai": { "type": "string" }, "anthropic": { "type": "string" } }
    },
    "updatePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["preferLatestStableWithinProfile", "requireOfficialSources", "requireAvailabilityConfirmation", "requireQualityAndSecurityChecks", "noSilentFallback", "noAutomaticPaidApiSwitch"],
      "properties": {
        "preferLatestStableWithinProfile": { "const": true },
        "requireOfficialSources": { "const": true },
        "requireAvailabilityConfirmation": { "const": true },
        "requireQualityAndSecurityChecks": { "const": true },
        "noSilentFallback": { "const": true },
        "noAutomaticPaidApiSwitch": { "const": true }
      }
    },
    "models": {
      "type": "object", "minProperties": 1,
      "propertyNames": { "pattern": "^[a-zA-Z][a-zA-Z0-9]+$" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["provider", "id"],
        "properties": {
          "provider": { "enum": ["openai", "anthropic"] },
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.\u002d][a-z0-9]+)*$", "maxLength": 100 }
        }
      }
    }
  }
}
