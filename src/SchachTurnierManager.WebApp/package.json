{
  "name": "schach-turnier-manager-webapp",
  "private": true,
  "version": "0.54.1",
  "type": "module",
  "scripts": {
    "build": "npm run test:qr:golden && npm run test:qr:runtime && npm run test:catalogs && npm run audit:i18n && tsc --noEmit && vite build --configLoader native --outDir ../../tmp/webapp-dist --emptyOutDir false",
    "dev": "vite --host 0.0.0.0 --port 5173",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:i18n": "node --experimental-strip-types --test ../../tests/scripts/i18n-core.test.mjs",
    "test:catalogs": "node --test ../../tests/scripts/i18n-catalogs.test.mjs ../../tests/scripts/i18n-entrypoint.test.mjs",
    "audit:i18n": "node ../../scripts/Test-I18nCatalogs.mjs",
    "test:pwa": "node --test ../../tests/scripts/service-worker.test.mjs ../../tests/scripts/service-worker-build.test.mjs",
    "prebuild": "npm run test:pwa",
    "test:backup": "node --test ../../tests/scripts/backup-preflight.test.mjs ../../tests/scripts/backup-check-ui.test.mjs",
    "test:progress": "node --test ../../tests/scripts/backlog-progress.test.mjs ../../tests/scripts/backlog-progress-fifo.test.mjs",
    "progress": "node ../../scripts/Measure-BacklogProgress.mjs --release v1.0.0",
    "test:startup": "node --test ../../tests/scripts/startup-guard.test.mjs",
    "test:backup:fingerprint": "node --test ../../tests/scripts/backup-fingerprint.test.mjs ../../tests/scripts/backup-fingerprint-ui.test.mjs",
    "test:backup:compare": "node --test ../../tests/scripts/backup-compare.test.mjs ../../tests/scripts/backup-compare-ui.test.mjs",
    "test:fide:offline": "node --test ../../tests/scripts/fide-search.test.mjs ../../tests/scripts/fide-search-ui.test.mjs",
    "test:support:summary": "node --test ../../tests/scripts/support-summary.test.mjs ../../tests/scripts/support-summary-ui.test.mjs",
    "test:connection:check": "node --test ../../tests/scripts/connection-check.test.mjs ../../tests/scripts/connection-check-ui.test.mjs",
    "test:i18n:sync": "node --experimental-strip-types --test ../../tests/scripts/language-preference.test.mjs",
    "test:browser:capabilities": "node --test ../../tests/scripts/browser-capabilities.test.mjs ../../tests/scripts/browser-capabilities-ui.test.mjs",
    "test:locales:content": "node --experimental-strip-types --test ../../tests/scripts/locales-content.test.mjs",
    "test:node:all": "node ../../scripts/Run-NodeTestSuites.mjs",
    "test:i18n:persistence": "node --experimental-strip-types --test ../../tests/scripts/language-persistence.test.mjs",
    "test:offline:notice": "node --test ../../tests/scripts/offline-notice.test.mjs",
    "test:privacy:curtain": "node --test ../../tests/scripts/privacy-curtain.test.mjs",
    "test:backup:duplicates": "node --test ../../tests/scripts/backup-duplicates.test.mjs",
    "test:audit:reader": "node --test ../../tests/scripts/audit-reader.test.mjs",
    "test:workflow:live": "node --test ../../tests/scripts/workflow-read-api.test.mjs ../../tests/scripts/workflow-live-standings.test.mjs",
    "test:workflow:backupset": "node --test ../../tests/scripts/workflow-read-api.test.mjs ../../tests/scripts/workflow-backup-set.test.mjs",
    "test:workflow:fidework": "node --test ../../tests/scripts/workflow-read-api.test.mjs ../../tests/scripts/workflow-fide-workbench.test.mjs",
    "test:backup:lock": "node --test ../../tests/scripts/backup-lock.test.mjs",
    "test:backup:reader": "node --test ../../tests/scripts/backup-reader.test.mjs",
    "test:qr:golden": "node --test ../../tests/scripts/qr-golden.test.mjs",
    "test:qr:runtime": "node --test ../../tests/scripts/qr-runtime.test.mjs",
    "test:rating:review": "node --test ../../tests/scripts/rating-review.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.0.16",
    "typescript": "6.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
