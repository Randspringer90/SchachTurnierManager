{
  "name": "schach-turnier-manager-webapp",
  "private": true,
  "version": "0.54.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "npm run test:catalogs && npm run audit:i18n && tsc --noEmit && vite build --configLoader native --outDir ../../tmp/webapp-dist --emptyOutDir false",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:i18n": "node --experimental-strip-types --test ../../tests/scripts/i18n-core.test.mjs",
    "test:catalogs": "node --test ../../tests/scripts/i18n-catalogs.test.mjs ../../tests/scripts/i18n-entrypoint.test.mjs",
    "audit:i18n": "node ../../scripts/Test-I18nCatalogs.mjs",
    "test:pwa": "node --test ../../tests/scripts/service-worker.test.mjs",
    "prebuild": "npm run test:pwa",
    "test:backup": "node --test ../../tests/scripts/backup-preflight.test.mjs ../../tests/scripts/backup-check-ui.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.0.16",
    "typescript": "6.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
