{
  "name": "schach-turnier-manager-webapp",
  "private": true,
  "version": "0.54.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "npm run test:backup:lock && npm run test:qr:golden && npm run test:qr:runtime && tsc --noEmit && vite build --configLoader native --outDir ../../tmp/webapp-dist --emptyOutDir false",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test:qr:golden": "node --test ../../tests/scripts/qr-golden.test.mjs",
    "test:qr:runtime": "node --test ../../tests/scripts/qr-runtime.test.mjs",
    "test:backup:lock": "node --test ../../tests/scripts/backup-lock.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.0.16",
    "typescript": "6.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
