<?xml version="1.0" encoding="utf-8"?>
<!-- Local-only source candidate: every request/navigation is separately origin-checked.
     No user CA, debug trust override or TLS certificate bypass. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
