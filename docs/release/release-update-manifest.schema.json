{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schachturniermanager.invalid/schemas/release-update-manifest-v1.json",
  "title": "SchachTurnierManager Release Update Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "version",
    "channel",
    "createdAtUtc",
    "updateMode",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "product": {
      "const": "SchachTurnierManager"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "channel": {
      "enum": ["stable", "preview"]
    },
    "createdAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "updateMode": {
      "const": "manual-only"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactType",
          "fileName",
          "relativePath",
          "sizeBytes",
          "sha256",
          "signature"
        ],
        "properties": {
          "artifactType": {
            "enum": ["desktop-zip", "portable-zip", "installer-exe"]
          },
          "fileName": {
            "type": "string",
            "minLength": 1
          },
          "relativePath": {
            "type": "string",
            "minLength": 1
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "signature": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "status", "signerThumbprint"],
            "properties": {
              "kind": {
                "enum": ["authenticode", "none"]
              },
              "status": {
                "enum": ["Valid", "NotSigned", "NotApplicable", "Unknown"]
              },
              "signerThumbprint": {
                "type": ["string", "null"],
                "pattern": "^[A-Fa-f0-9]{40,64}$"
              }
            }
          }
        }
      }
    }
  }
}
